# Copia este fichero a .env y rellena los valores de tu proyecto de Supabase
# (Project Settings → API). Sin ellos la app arranca en modo demostración con
# datos de mentira guardados en el navegador.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Solo lo usa `npm run covers` / `npm run ids` / `npm run ingest:bgg`, nunca la app: no
# lleva el prefijo VITE_ y por tanto no acaba en el bundle. El alta es gratuita para uso
# no comercial en https://boardgamegeek.com/using_the_xml_api — sin él las etapas que
# hablan con BGG se saltan.
BGG_API_TOKEN=

# Solo lo usa `npm run ingest:bgg`, que siembra el catálogo amplio escribiendo por red.
# La clave de servicio se salta la RLS: puede escribir en `games`, que nadie más puede.
# Sin prefijo VITE_ a propósito — si acabara en el bundle, cualquiera podría reescribir
# el catálogo entero. Está en Project Settings → API, como `service_role`.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
