# Copia este fichero a .env y rellena los valores de tu proyecto de Supabase
# (Project Settings → API). Sin ellos la app arranca en modo demostración con
# datos de mentira guardados en el navegador.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Solo lo usa `npm run covers` / `npm run ids`, nunca la app: no lleva el prefijo VITE_
# y por tanto no acaba en el bundle. El alta es gratuita para uso no comercial en
# https://boardgamegeek.com/using_the_xml_api — sin él las dos etapas de BGG se saltan.
BGG_API_TOKEN=
